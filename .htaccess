<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Deny hidden files and directories (.env, .git, etc.)
    RewriteRule (^|/)\. - [F,L]

    # Stop processing if the request is already inside public/
    RewriteRule ^public/ - [L]

    # Route everything else into public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
