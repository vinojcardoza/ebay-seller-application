# Local database credentials
MARIADB_DATABASE=dbname
MARIADB_USER=user
MARIADB_PASSWORD=password
MARIADB_ROOT_PASSWORD=root_password

# eBay REST API (developer.ebay.com → Application Keys / User Tokens).
# Never commit real values; .env is git-ignored.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# RuName ("eBay Redirect URL name"). Set its auth accepted URL to https://<your-host>/ebay/callback.
EBAY_RU_NAME=
# production or sandbox
EBAY_ENVIRONMENT=production
EBAY_MARKETPLACE_ID=EBAY_GB
# Your eBay username, used to import feedback.
EBAY_SELLER_USERNAME=
