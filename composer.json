{
    "name": "vinojcardoza/business-mvc-php",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Vinoj Cardoza",
            "email": "vinoj.cardoza@gmail.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "squizlabs/php_codesniffer": "^4.0",
        "phpstan/phpstan": "^2.2"
    },
    "require": {
        "vlucas/phpdotenv": "^5.7",
        "guzzlehttp/psr7": "^3.1",
        "php-di/php-di": "^7.1",
        "doctrine/orm": "^3.7",
        "symfony/cache": "^8.1",
        "httpsoft/http-emitter": "^1.1",
        "league/route": "^7.0"
    },
    "scripts": {
        "phpcs": "vendor/bin/phpcs src config tests",
        "phpcbf": "vendor/bin/phpcbf src config tests",
        "phpstan": "vendor/bin/phpstan analyse src config tests",
        "phpunit": "vendor/bin/phpunit tests",
        "lint": [
            "@phpcbf",
            "@phpcs",
            "@phpstan",
            "@phpunit"
        ]
    }
}
